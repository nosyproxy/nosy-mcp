.PHONY: link unlink build test check fmt clean

CARGO ?= cargo
# Local checkout of github.com/nosyproxy/nosy used by `make link`.
CORE ?= ../nosy
GIT_SRC := https://github.com/nosyproxy/nosy

## Build against the local core checkout instead of the git dependency (writes .cargo/config.toml).
## Cargo.lock is saved first: the patch rewrites it, `make unlink` puts the pinned one back.
link:
	@test -d $(CORE) || { echo "nosy core not found at $(CORE)"; exit 1; }
	@mkdir -p .cargo
	@test -f .cargo/Cargo.lock.pinned || cp Cargo.lock .cargo/Cargo.lock.pinned
	@printf '# Generated by `make link` (git-ignored): use the local core checkout.\n[patch."$(GIT_SRC)"]\n' > .cargo/config.toml
	@for c in nosy-model nosy-codec nosy-server; do \
		printf '%s = { path = "%s/crates/%s" }\n' $$c $(abspath $(CORE)) $$c >> .cargo/config.toml; done
	@cat .cargo/config.toml

## Back to the git dependency pinned in Cargo.lock.
unlink:
	@if [ -f .cargo/Cargo.lock.pinned ]; then mv .cargo/Cargo.lock.pinned Cargo.lock; fi
	rm -rf .cargo

## Optimized binary: target/release/nosy-mcp
build:
	$(CARGO) build --release

test:
	$(CARGO) test --workspace

check:
	$(CARGO) fmt --all --check
	$(CARGO) clippy --workspace --all-targets -- -D warnings
	$(CARGO) test --workspace

fmt:
	$(CARGO) fmt --all

clean:
	$(CARGO) clean
